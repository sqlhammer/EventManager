<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>EventManager.Hub</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <!-- Security pin (version + rationale in Directory.Packages.props). -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
    <!-- U10 replication adapter: metrics export + DPAPI protection for the hub credential. -->
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\shared\EventManager.Domain\EventManager.Domain.csproj" />
    <ProjectReference Include="..\..\shared\EventManager.Sync\EventManager.Sync.csproj" />
    <ProjectReference Include="..\..\shared\EventManager.Contracts\EventManager.Contracts.csproj" />
  </ItemGroup>

</Project>
