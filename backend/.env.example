# Copy to `.env` (git-ignored) for local/dev; use a provider secret manager in production (Q3=A, NFR-2.6).
# Never commit real secrets or bake them into images.

POSTGRES_DB=eventmanager
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password

# 32+ char signing key for JWTs (SP-1). Generate a random value per environment.
JWT_SIGNING_KEY=change-me-32-plus-character-signing-key

# Symmetric key used to encrypt daily backups (NFR-3.10).
BACKUP_ENCRYPTION_KEY=change-me-backup-encryption-key

# Public site address for Caddy TLS (prod). Local dev can use localhost.
SITE_ADDRESS=localhost
